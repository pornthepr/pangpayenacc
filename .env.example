# From Supabase dashboard > Project Settings > API Keys. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER expose to the client, NEVER set in Vercel — only used
# locally by scripts/seed-users.ts and scripts/reset-password.ts.
SUPABASE_SECRET_KEY=

# Internal email domain used to turn a username into a Supabase Auth email
# (e.g. golf@family.local). Users never see this.
INTERNAL_EMAIL_DOMAIN=family.local

# Optional: override the seeded default passwords (otherwise golf1234/gap1234/group1234).
# SEED_PASSWORD_GOLF=
# SEED_PASSWORD_GAP=
# SEED_PASSWORD_GROUP=
